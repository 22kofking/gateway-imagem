# Copie para .env e preencha. Nunca coloque o .env no Git.

# --- Provedores (ficam só no gateway, nunca nos apps) ---
RUNPOD_API_KEY=
# Id do seu endpoint Serverless (pasta worker/). Vazio = usa só os modelos prontos da RunPod.
RUNPOD_ENDPOINT_RAPIDO=
# Opcional: fal.ai como reserva
FAL_KEY=

# --- Apps clientes: chave:nome[:limite_de_imagens_por_dia], separados por vírgula ---
# Gere chaves com: python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_APP_KEYS=troque-esta-chave:meu-site:500,outra-chave:meu-bot

# --- Opções ---
GATEWAY_DB=gateway.db
# Quanto tempo o modo "wait": true espera (segundos)
GATEWAY_SYNC_WAIT=60

# --- Storage das imagens (opcional, recomendado em produção) ---
# Exemplo Cloudflare R2: S3_ENDPOINT_URL=https://<conta>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket (domínio próprio ou r2.dev)
S3_PUBLIC_BASE_URL=
